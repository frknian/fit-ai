# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# editor / local tooling state
/.idea/
/.claude/
/.codex/
/.openai/
/.agents/
/.cursor/
/.aider*
/AGENTS.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# Yerel model eğitim/dönüştürme çalışma alanı (repoya girmez)
.hedefit-ml/

.idea/

# Yerel model benchmark çıktıları
/.benchmark/

# Supabase CLI geçici çalışma dizini
supabase/.temp/

# Python derleme artıkları (scripts/ml)
__pycache__/
*.pyc
