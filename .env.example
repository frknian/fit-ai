# AI plan üretimi, sohbet, öğün fotoğrafı analizi ve haftalık değerlendirme.
# OpenAI-uyumlu herhangi bir uç nokta çalışır: Moonshot (Kimi), OpenRouter,
# Together, Fireworks veya kendi vLLM/Ollama sunucunuz. Anahtar tanımlı
# değilse uygulama her yerde güvenli yerel yedeğe düşer (AI olmadan da
# çalışır, sadece kişiselleştirme azalır).
AI_API_KEY=
# Varsayılan: Moonshot AI'nin Kimi K3 modeli — native görsel girdi destekler
# (vücut analizi fotoğrafı), ayrı bir görsel modele gerek yoktur.
AI_BASE_URL=https://api.moonshot.ai/v1
AI_MODEL=kimi-k3
# Kalori takibi: yazılı yemek+gramaj K2.6 ile tahmin edilir.
AI_NUTRITION_TEXT_MODEL=kimi-k2.6
AI_PROVIDER_NAME=moonshot

# Yönlendirme modu.
#   auto   — varsayılan: uzak sağlayıcı, ardından deterministik güvenli yedek
#   local  — ücretli çağrı YAPILMAZ; yalnız güvenli deterministik yanıtlar
#            (sağlayıcı kotası dolduğunda uygulamayı ayakta tutmak için)
#   remote — yalnız uzak sağlayıcı kullanılır
AI_ROUTING_MODE=auto
# AI olaylarını üretimde de sunucu log'una yazar (gizlilik: yalnız sağlayıcı,
# model, gecikme, hata SINIFI — istek/yanıt metni asla yazılmaz).
AI_DEBUG=
# OpenRouter kullanacaksanız örnek:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=qwen/qwen2.5-vl-72b-instruct   (OpenRouter'daki tam kimliği doğrulayın)
#   AI_PROVIDER_NAME=openrouter
#   AI_SITE_URL=https://hedefit.frknian.workers.dev   (AI sağlayıcısı kontrol panelinde uygulama kimliği için)

# Supabase bağlantısı
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnız sunucu tarafındaki yönetim işlemleri için. NEXT_PUBLIC_ öneki eklemeyin.
SUPABASE_SECRET_KEY=
