# Fit Koç bulut AI. Anahtar yalnız sunucu/Worker secret olarak tutulur.
OPENAI_API_KEY=
# Akıllı yönlendirme: basit sohbet ve çıkarımlar 4o, kişisel planlama ve
# karmaşık haftalık değerlendirme GPT-5.1 kullanır.
OPENAI_MODEL_CHEAP=gpt-4o
OPENAI_MODEL_STANDARD=gpt-4o
OPENAI_MODEL_ADVANCED=gpt-5.1

# Yönlendirme modu.
#   auto   — varsayılan: uzak sağlayıcı, ardından deterministik güvenli yedek
#   local  — ücretli çağrı YAPILMAZ; yalnız güvenli deterministik yanıtlar
#            (sağlayıcı kotası dolduğunda uygulamayı ayakta tutmak için)
#   remote — yalnız uzak sağlayıcı kullanılır
AI_ROUTING_MODE=auto
# AI olaylarını üretimde de sunucu log'una yazar (gizlilik: yalnız sağlayıcı,
# model, gecikme, hata SINIFI — istek/yanıt metni asla yazılmaz).
AI_DEBUG=
# Supabase bağlantısı
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnız sunucu tarafındaki yönetim işlemleri için. NEXT_PUBLIC_ öneki eklemeyin.
SUPABASE_SECRET_KEY=
