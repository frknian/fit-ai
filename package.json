{
  "name": "hedefit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint app lib worker --ignore-pattern dist --ignore-pattern .next",
    "data:import-exercises": "node scripts/import-free-exercise-db.mjs",
    "data:sync-plan-media": "node scripts/sync-plan-exercise-media.mjs"
  },
  "//overrides": "Güvenlik yamaları: bu paketler geçişli bağımlılık olarak açıklı sürümlerde geliyor (OWASP A06).",
  "overrides": {
    "undici": "^7.28.0",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@supabase/supabase-js": "^2.110.7",
    "ai": "^7.0.37",
    "next": "^16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
