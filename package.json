{
  "name": "hedefit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/fix-vinext-worker-modules.mjs",
    "deploy": "node scripts/deploy-with-openai-check.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint app lib worker --ignore-pattern dist --ignore-pattern .next",
    "data:import-exercises": "node scripts/import-free-exercise-db.mjs",
    "data:sync-plan-media": "node scripts/sync-plan-exercise-media.mjs"
  },
  "//overrides": "Güvenlik yamaları: bu paketler geçişli bağımlılık olarak açıklı sürümlerde geliyor (OWASP A06).",
  "overrides": {
    "undici": "^7.28.0",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.50",
    "@supabase/supabase-js": "^2.110.7",
    "ai": "^7.0.37",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
